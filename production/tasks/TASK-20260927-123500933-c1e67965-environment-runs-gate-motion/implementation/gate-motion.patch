+        [Test]
+        public void LeanAndExitSyncsThatMoveAGateAfterRestartAllocateNothing()
+        {
+            // The first attempt warms every path (JIT, tween, sequence, delay and particle state); Restart
+            // replays it: a lean that lowers the gate, then an exit before the gate is down.
