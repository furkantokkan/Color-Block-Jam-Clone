+                Assert.That(m_view.BoardRoot.GetComponentsInChildren<BoardPieceView>(true), Is.Empty,
+                    "Release destroys the pooled base squares.");
+            }
+            finally
+            {
+                m_view.Release();
+                Object.DestroyImmediate(database);
+            }
+        }
