+        [UnityTest]
+        public IEnumerator DoorsCarryTheirPaletteColourAndPiecesResetWhenReleased()
+        {
+            m_view.Build(Create(5, 4, new LevelDoorData("top", BoardSide.Top, 1, 2, "Red")));
+            yield return null;
