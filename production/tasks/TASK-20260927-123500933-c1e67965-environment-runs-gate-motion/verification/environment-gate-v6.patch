+        // A straight wall quadrant has floor on exactly one side; its run goes across that side.
+        private bool TryGetStraightAxis(Vector2Int position, out Vector2Int axis)
+        {
+            bool left = m_matcher.IsFloor(position.x - 1, position.y);
+            bool right = m_matcher.IsFloor(position.x + 1, position.y);
+            bool down = m_matcher.IsFloor(position.x, position.y - 1);
+            bool up = m_matcher.IsFloor(position.x, position.y + 1);
+            int floorSides = (left ? 1 : 0) + (right ? 1 : 0) + (down ? 1 : 0) + (up ? 1 : 0);
+            axis = left || right ? Vector2Int.up : Vector2Int.right;
+            return floorSides == 1;
+        }
+
+        private bool IsSameRun(Vector2Int position, Vector2Int axis, int rule, int yaw)
+        {
+            if (!m_quadrantBounds.Contains(position))
+            {
+                return false;
+            }
+
+            int index = GetQuadrantIndex(position);
+            return m_wallRules[index] == rule && m_wallYaws[index] == yaw && !m_usedWalls[index]
+                && TryGetStraightAxis(position, out Vector2Int runAxis) && runAxis == axis;
+        }
+
+        // One brick over the whole run through position: Brick_End on its first and last quadrants with
+        // their mouths turned inward, and the rule's own wall piece on every quadrant between them.
+        private void AddBrick(Vector2Int position, Vector2Int axis, Vector3 scale, Color tint,
+            List<EnvironmentPiecePlacement> output)
+        {
+            int index = GetQuadrantIndex(position);
+            int rule = m_wallRules[index];
+            int yaw = m_wallYaws[index];
+            Vector2Int first = position;
+            while (IsSameRun(first - axis, axis, rule, yaw))
+            {
+                first -= axis;
+            }
+
+            int length = 0;
+            for (Vector2Int next = first; IsSameRun(next, axis, rule, yaw); next += axis)
+            {
+                m_usedWalls[GetQuadrantIndex(next)] = true;
+                length++;
+            }
+
+            BoardPieceView end = m_database.BrickEndPiece;
+            if (length == 1)
+            {
+                // Two half-length ends back to back keep a one-quadrant run closed and rounded at both ends.
+                Vector3 halfScale = new Vector3(scale.x, scale.y, scale.z * 0.5f);
+                Vector3 center = GetQuadrantCenter(first);
+                Vector3 offset = new Vector3(axis.x, axis.y, 0f) * k_halfEndOffset;
+                output.Add(new EnvironmentPiecePlacement(end, center - offset, GetBrickEndYaw(axis), halfScale, tint));
+                output.Add(new EnvironmentPiecePlacement(end, center + offset, GetBrickEndYaw(-axis), halfScale, tint));
+                return;
+            }
+
+            output.Add(new EnvironmentPiecePlacement(end, GetQuadrantCenter(first), GetBrickEndYaw(axis), scale, tint));
