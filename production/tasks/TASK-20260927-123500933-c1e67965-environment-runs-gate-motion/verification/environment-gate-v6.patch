diff --git a/Assets/ColorBlockJam/Editor/BoardKit/EnvironmentWallBrickAssets.cs b/Assets/ColorBlockJam/Editor/BoardKit/EnvironmentWallBrickAssets.cs
new file mode 100644
index 0000000..ce2d5cf
--- /dev/null
+++ b/Assets/ColorBlockJam/Editor/BoardKit/EnvironmentWallBrickAssets.cs
@@ -0,0 +1,139 @@
+using System;
+using ColorBlockJam.Environment;
+using ColorBlockJam.Presentation.Board;
+using UnityEditor;
+using UnityEngine;
+
+namespace ColorBlockJam.Editor.BoardKit
+{
+    /// <summary>
+    /// Imports the Blender-authored WallBrick.fbx, builds Brick_End.prefab with Wall.prefab's calibration
+    /// and binds it in the EnvironmentDatabase (DEC-139). It writes only those three assets: the full kit
+    /// rebuilds (BoardKitAssets.Build, SharedArtAssets) regenerate unrelated assets and stay out of it.
+    /// </summary>
+    public static class EnvironmentWallBrickAssets
+    {
+        public const string ModelPath = BoardKitAssets.Root + "/Art/Models/WallBrick.fbx";
+        public const string PrefabPath = BoardKitAssets.Root + "/Prefabs/Board/Pieces/Brick_End.prefab";
+        private const string k_wallModelPath = BoardKitAssets.Root + "/Art/Models/WallAndDoor.fbx";
+        private const string k_wallPrefabPath = BoardKitAssets.Root + "/Prefabs/Board/Pieces/Wall.prefab";
+        private const string k_databasePath = BoardKitAssets.Root + "/Data/Environment/EnvironmentDatabase.asset";
+        private const string k_meshName = "Brick_End";
+        private const string k_wallMeshName = "Wall";
+        // Brick_End is authored inside Wall's exact mesh bounds (ArtSource/BoardKit/WallBrick.blend).
+        private const float k_boundsTolerance = 0.001f;
+
+        [MenuItem("Color Block Jam/Art/Build Wall Brick")]
+        public static void Build()
+        {
+            if (EditorApplication.isPlayingOrWillChangePlaymode)
+            {
+                throw new InvalidOperationException("Build the wall brick outside Play Mode.");
+            }
+
+            ConfigureImporter();
+            Mesh brick = FindMesh(ModelPath, k_meshName);
+            Mesh wall = FindMesh(k_wallModelPath, k_wallMeshName);
+            // Equal bounds prove the brick shares Wall's mesh space, so Wall's prefab calibration fits it.
+            if (!IsClose(brick.bounds.min, wall.bounds.min) || !IsClose(brick.bounds.max, wall.bounds.max))
+            {
+                throw new InvalidOperationException(
+                    $"Brick_End bounds {brick.bounds} differ from Wall bounds {wall.bounds}; re-export WallBrick.fbx.");
+            }
+
+            BoardPieceView piece = CreatePrefab(brick);
+            BindDatabase(piece);
+            AssetDatabase.SaveAssets();
+            Debug.Log($"Wall brick built: {PrefabPath} bound in {k_databasePath}.");
+        }
+
+        // The supplied kit's mesh-space import (WallAndDoor.fbx) with materials, animation and Read/Write off.
+        private static void ConfigureImporter()
+        {
+            ModelImporter source = (ModelImporter)AssetImporter.GetAtPath(k_wallModelPath);
+            ModelImporter importer = (ModelImporter)AssetImporter.GetAtPath(ModelPath);
+            if (source == null || importer == null)
+            {
+                throw new InvalidOperationException($"Import {ModelPath} and {k_wallModelPath} first.");
+            }
+
+            importer.globalScale = source.globalScale;
+            importer.useFileScale = source.useFileScale;
+            importer.bakeAxisConversion = source.bakeAxisConversion;
+            importer.importNormals = source.importNormals;
+            importer.normalSmoothingAngle = source.normalSmoothingAngle;
+            importer.importTangents = source.importTangents;
+            importer.weldVertices = source.weldVertices;
+            importer.keepQuads = source.keepQuads;
+            importer.meshCompression = source.meshCompression;
+            importer.indexFormat = source.indexFormat;
+            importer.materialImportMode = ModelImporterMaterialImportMode.None;
+            importer.importAnimation = false;
+            importer.animationType = ModelImporterAnimationType.None;
+            importer.importBlendShapes = false;
+            importer.importCameras = false;
+            importer.importLights = false;
+            importer.importVisibility = false;
+            importer.isReadable = false;
+            importer.addCollider = false;
+            importer.SaveAndReimport();
+        }
+
+        // Wall.prefab's root, Visual child, X180 turn, height and stretch, shared material and view fields,
+        // with only the mesh replaced.
+        private static BoardPieceView CreatePrefab(Mesh brick)
+        {
+            GameObject root = PrefabUtility.LoadPrefabContents(k_wallPrefabPath);
+            try
+            {
+                root.name = k_meshName;
+                BoardPieceView view = root.GetComponent<BoardPieceView>();
+                if (view == null || view.Filter == null)
+                {
+                    throw new InvalidOperationException("Wall.prefab has no BoardPieceView with a mesh filter.");
+                }
+
+                view.Filter.sharedMesh = brick;
+                return PrefabUtility.SaveAsPrefabAsset(root, PrefabPath).GetComponent<BoardPieceView>();
+            }
+            finally
+            {
+                PrefabUtility.UnloadPrefabContents(root);
+            }
+        }
+
+        private static void BindDatabase(BoardPieceView piece)
+        {
+            EnvironmentDatabase database = AssetDatabase.LoadAssetAtPath<EnvironmentDatabase>(k_databasePath);
+            if (database == null)
+            {
+                throw new InvalidOperationException($"No environment database at {k_databasePath}.");
+            }
+
+            SerializedObject data = new SerializedObject(database);
+            data.FindProperty("m_brickEndPiece").objectReferenceValue = piece;
+            data.ApplyModifiedPropertiesWithoutUndo();
+            EditorUtility.SetDirty(database);
+            AssetDatabase.SaveAssetIfDirty(database);
+        }
+
+        private static Mesh FindMesh(string path, string name)
+        {
+            foreach (UnityEngine.Object asset in AssetDatabase.LoadAllAssetsAtPath(path))
+            {
+                if (asset is Mesh mesh && mesh.name == name)
+                {
+                    return mesh;
+                }
+            }
+
+            throw new InvalidOperationException($"No mesh {name} in {path}.");
+        }
+
+        private static bool IsClose(Vector3 a, Vector3 b)
+        {
+            return Mathf.Abs(a.x - b.x) <= k_boundsTolerance && Mathf.Abs(a.y - b.y) <= k_boundsTolerance
+                && Mathf.Abs(a.z - b.z) <= k_boundsTolerance;
+        }
+    }
+}
