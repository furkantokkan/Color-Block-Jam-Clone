diff --git a/ArtSource/BoardKit/export_wall_brick.py b/ArtSource/BoardKit/export_wall_brick.py
new file mode 100644
index 0000000..17fadda
--- /dev/null
+++ b/ArtSource/BoardKit/export_wall_brick.py
@@ -0,0 +1,66 @@
+"""Exports Brick_End from WallBrick.blend to Assets/ColorBlockJam/Art/Models/WallBrick.fbx (DEC-139).
+
+WallBrick.blend holds Brick_End, the wall-run cap built from the supplied Wall profile inside Wall's exact
+mesh bounds, and Wall_Reference, an unchanged copy of the supplied Wall kept only to check calibration.
+Only Brick_End is exported, with the node transform of the approved generator
+(production/tasks/TASK-20260927-123500933-c1e67965-environment-runs-gate-motion/implementation/
+approved-brick/build_brick_end.py) and the supplied kit's unit convention: WallAndDoor.fbx stores its
+units as FBX UnitScaleFactor 100, so this export writes units to the FBX scale too (FBX_SCALE_UNITS).
+Unity then reads Brick_End in Wall's mesh space, and Wall.prefab's calibration fits it. The script
+re-imports the file and checks the unit scale and that Brick_End kept its bounds.
+
+Run from the repository root (Blender 4.1+):
+  blender --background --factory-startup ArtSource/BoardKit/WallBrick.blend --python ArtSource/BoardKit/export_wall_brick.py
+Then run Color Block Jam > Art > Build Wall Brick in Unity.
+"""
+import os
+import struct
+
+import bpy
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+FBX_PATH = os.path.normpath(os.path.join(HERE, "..", "..", "Assets", "ColorBlockJam", "Art", "Models", "WallBrick.fbx"))
+NAME = "Brick_End"
+TOLERANCE = 1e-4
+# WallAndDoor.fbx's UnitScaleFactor; the FBX binary stores it as a little-endian double after its name.
+KIT_UNIT_SCALE = 100.0
+
+
+def local_bounds(obj):
+    xs, ys, zs = zip(*(tuple(v.co) for v in obj.data.vertices))
+    return (min(xs), min(ys), min(zs), max(xs), max(ys), max(zs))
+
+
+def unit_scale_factor(path):
+    data = open(path, "rb").read()
+    key = b"UnitScaleFactorS\x06\x00\x00\x00doubleS\x06\x00\x00\x00NumberS\x00\x00\x00\x00D"
+    start = data.find(key)
+    if start < 0:
+        raise SystemExit(f"[wall-brick] no UnitScaleFactor in {path}")
+    return struct.unpack("<d", data[start + len(key):start + len(key) + 8])[0]
+
+
+def main():
+    brick = bpy.data.objects[NAME]
+    expected = local_bounds(brick)
+    bpy.ops.object.select_all(action="DESELECT")
+    brick.select_set(True)
+    bpy.context.view_layer.objects.active = brick
+    bpy.ops.export_scene.fbx(filepath=FBX_PATH, use_selection=True, object_types={"MESH"},
+                             apply_scale_options="FBX_SCALE_UNITS", bake_space_transform=False,
+                             mesh_smooth_type="FACE", add_leaf_bones=False, bake_anim=False)
+    if abs(unit_scale_factor(FBX_PATH) - KIT_UNIT_SCALE) > TOLERANCE:
+        raise SystemExit(f"[wall-brick] UnitScaleFactor {unit_scale_factor(FBX_PATH)} differs from the kit's {KIT_UNIT_SCALE}")
+
+    bpy.ops.wm.read_factory_settings(use_empty=True)
+    bpy.ops.import_scene.fbx(filepath=FBX_PATH)
+    meshes = [obj for obj in bpy.context.scene.objects if obj.type == "MESH"]
+    if len(meshes) != 1 or not meshes[0].name.startswith(NAME):
+        raise SystemExit(f"[wall-brick] expected only {NAME} in {FBX_PATH}, found {[obj.name for obj in meshes]}")
+    actual = local_bounds(meshes[0])
+    if max(abs(a - b) for a, b in zip(expected, actual)) > TOLERANCE:
+        raise SystemExit(f"[wall-brick] round trip changed the bounds: {expected} -> {actual}")
+    print(f"[wall-brick] exported {NAME} to {FBX_PATH}; bounds {tuple(round(v, 5) for v in actual)}")
+
+
+main()
