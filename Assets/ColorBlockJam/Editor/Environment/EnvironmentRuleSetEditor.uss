.rule-set__rule {
    margin-top: 6px;
    padding: 6px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(0, 0, 0, 0.35);
    background-color: rgba(0, 0, 0, 0.08);
}

.rule-set__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.rule-set__title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.rule-set__header-button {
    width: 24px;
}

.rule-set__body {
    flex-direction: row;
    align-items: flex-start;
}

.rule-set__grid {
    margin-right: 8px;
}

.rule-set__row {
    flex-direction: row;
}

.rule-set__cell {
    width: 42px;
    height: 30px;
    -unity-text-align: middle-center;
    margin: 1px;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 3px;
}

.rule-set__cell--any {
    background-color: rgb(88, 88, 88);
    color: rgb(190, 190, 190);
}

.rule-set__cell--floor {
    background-color: rgb(46, 150, 72);
    color: rgb(255, 255, 255);
}

.rule-set__cell--void {
    background-color: rgb(186, 58, 52);
    color: rgb(255, 255, 255);
}

.rule-set__cell--centre {
    background-color: rgb(52, 90, 160);
    color: rgb(255, 255, 255);
}

.rule-set__fields {
    flex-grow: 1;
}

.rule-set__add {
    margin-top: 8px;
}
