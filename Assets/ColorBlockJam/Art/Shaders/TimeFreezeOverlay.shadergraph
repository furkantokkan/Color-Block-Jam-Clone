{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "5f7e1c0a00000000400080000000c00a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "FrostEdge (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -500.0,
            "y": 300.0,
            "width": 240.0,
            "height": 350.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "5f7e1c0a00000000400080000000f001"
        },
        {
            "m_Id": "5f7e1c0a00000000400080000000f002"
        },
        {
            "m_Id": "5f7e1c0a00000000400080000000f003"
        },
        {
            "m_Id": "5f7e1c0a00000000400080000000f004"
        },
        {
            "m_Id": "5f7e1c0a00000000400080000000f005"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FrostEdge",
    "m_FunctionSource": "",
    "m_FunctionBody": "// Screen-edge frost (B-25). ScreenUV runs 0..1 across the camera quad; the frost is strong at the edges and clear in the centre.\n// Distance to the nearest edge on each axis: 0 at an edge, 0.5 at the centre.\nfloat2 edgeDistance = min(ScreenUV, 1.0 - ScreenUV);\n// Band widths in UV, about the same pixel width on a 9:16 portrait view (0.26 x 1080 and 0.15 x 1920, about 285 px), so the top and bottom bands reach past the HUD bars.\nfloat2 band = saturate(1.0 - edgeDistance / float2(0.26, 0.15));\nfloat mask = max(band.x, band.y);\n// Smooth falloff: nearly solid at the edge, a soft inner border instead of a thin fading line.\nmask = smoothstep(0.0, 1.0, mask);\n// The ice texture's brightness breaks the band into frost patches, so it reads as ice rather than a gradient.\nfloat detail = dot(IceSample.rgb, float3(0.299, 0.587, 0.114));\nmask = saturate(mask * (0.8 + 0.4 * detail));\n// Deep ice blue toward the inner border, near white at the screen edge: the pale-blue clear colour would hide a white-only frost.\nfloat3 ice = lerp(IceSample.rgb, float3(1.0, 1.0, 1.0), 0.35);\nFrostColor = lerp(float3(0.36, 0.70, 1.0), float3(0.93, 0.98, 1.0), mask) * ice;\n// A lighter 0.08 veil chills the whole view; peak opacity 0.85 at the edge.\nFrostAlpha = saturate(0.08 + mask * 0.77) * saturate(Amount);"
}

